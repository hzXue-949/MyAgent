# --- LLM 服务配置（必填）---
# 指向任何兼容 OpenAI 接口的服务
LLM_API_KEY="YOUR-API-KEY"
LLM_MODEL_ID="YOUR-MODEL"
LLM_BASE_URL="YOUR-URL"
# 可选，默认 60 秒
LLM_TIMEOUT=60

# --- 搜索工具配置（按需配置一个或多个）---
# 前往 https://serpapi.com/ 注册获取
SERPAPI_API_KEY="YOUR_SERPAPI_API_KEY"
# Tavily 后端可选；使用前在虚拟环境中安装 tavily-python
TAVILY_API_KEY="YOUR_TAVILY_API_KEY"

# --- 第 8 章记忆系统（均可选，默认使用本地 SQLite）---
MEMORY_DB_PATH="data/memory.sqlite3"
WORKING_MEMORY_CAPACITY=50
WORKING_MEMORY_TTL_MINUTES=60
# 用户维度隔离由 MemoryTool(user_id=...) 控制；不要在共享服务中固定使用同一个 user_id。
# 云端可选适配：安装 `uv sync --extra memory-cloud` 后按需配置。
# 嵌入模型二选一；local 是真正的本地预训练模型，需要 memory-local 扩展。
EMBED_MODEL_TYPE="local"
EMBED_MODEL_NAME="BAAI/bge-small-zh-v1.5"
# local 的维度由模型读取（默认 BGE 为 512 维），不要沿用旧哈希向量的 384 维。
EMBED_DIMENSIONS=""
EMBED_DEVICE="cpu"
# 百炼方案：TYPE=dashscope，NAME=text-embedding-v4（或账户有额度的模型），DIMENSIONS=1024。
# 填入控制台提供的北京地域业务空间专属 OpenAI 兼容 base_url。
EMBED_API_KEY=""
EMBED_BASE_URL=""
EMBED_TIMEOUT=60
# Qdrant 集合名会自动附加模型配置指纹，避免新旧向量混用。
QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_COLLECTION="myagent_memory"
NEO4J_URI=""
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD=""
NEO4J_DATABASE="neo4j"
